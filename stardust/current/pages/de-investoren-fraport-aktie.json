      "value": [
        {
          "headline": null,
          "text": "Die nachfolgende Übersicht stellt unsere aktuelle Aktionärsstruktur dar.",
          "image": null,
          "variant": [
            "frach-m-text-media--100"
          ]
        },
        {
          "headline": null,
          "text": "* Die relativen Anteile der Aktionäre wurden an die aktuelle Gesamtzahl der Aktien angepasst und können daher zum Meldezeitpunkt beziehungsweise von den eigenen Angaben der Anteilseigner abweichen. A…",
          "image": null,
          "variant": [
            "frach-m-text-media--100"
          ]
        },
        {
          "headline": null,
          "text": "Die ordentliche Hauptversammlung der Fraport AG hat am 12. Mai 2026 dem Vorschlag von Vorstand und Aufsichtsrat zur Ausschüttung einer Dividende in Höhe von 1,00 Euro je Aktie für das Geschäftsjahr 2…",
          "image": null,
          "variant": [
            "frach-m-text-media--100"
          ]
        },
        {
          "headline": null,
          "text": "Die Mitarbeiterinnen und Mitarbeiter eines Dienstleistungsunternehmens prägen mit ihrem Wissen und Engagement maßgeblich die Wahrnehmung des Unternehmens durch unsere Kunden und tragen so zum Unterne…",
          "image": null,
          "variant": [
            "frach-m-text-media--100"
          ]
        }
      ],
      "count": 4,
      "source": "main frach-m-text-media"
    },
