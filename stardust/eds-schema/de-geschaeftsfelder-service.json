    {
     "role": "body",
     "order": 0,
     "text": "ANGEBOTE AM FLUGHAFEN FRANKFURT"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Entdecken Sie die vielfältigen Leistungen am Frankfurt Airport. Fraport bietet maßgeschneiderte Lösungen und umfassende Services, die einen effizienten und modernen Flughafenbetrieb ermöglichen – für Partner, Unternehmen und Gäste gleichermaßen."
    },
    {
     "role": "body",
     "order": 2,
     "text": "Entdecken Sie die vielfältigen Park- und Mobilitätsangebote am Frankfurt Airport – für eine stressfreie und komfortable Anreise."
    },
    {
     "role": "heading",
     "order": 3,
     "text": "Parken & Mobilität"
    },
    {
     "role": "body",
     "order": 4,
     "text": "Erleben Sie Retail und Advertising am Frankfurt Airport – für erfolgreiche Markenpräsenz und vielfältige Shopping-Erlebnisse."
    },
    {
     "role": "heading",
     "order": 5,
     "text": "Retailing and Advertising"
    },
    {
     "role": "body",
     "order": 6,
     "text": "Entdecken Sie attraktive Retail-Flächen und innovative Shopping-Konzepte am Frankfurt Airport."
    },
    {
     "role": "heading",
     "order": 7,
     "text": "Airport Retailing"
    }
